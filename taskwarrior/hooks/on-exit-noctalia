#!/bin/bash
# Taskwarrior on-exit hook: notify Noctalia Shell on task changes

# Cooldown guard: prevent rapid re-triggering (feedback loop protection)
LOCK="/tmp/noctalia-tw-hook.lock"
if [ -f "$LOCK" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$LOCK" 2>/dev/null || echo 0) ))
    if [ "$age" -lt 2 ]; then
        exit 0
    fi
fi
touch "$LOCK"

qs -c noctalia-shell ipc call plugin:taskwarrior refresh &
exit 0
